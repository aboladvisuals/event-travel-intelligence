# Copy to .env locally. Never commit real keys.

APP_VERSION=1.6.0
LOG_LEVEL=INFO
DEBUG_ERRORS=false

# SQLite is the default operational store.
DATABASE_PATH=data/platform.sqlite
# DATABASE_URL=postgresql://user:pass@host:5432/eti
# REDIS_URL=redis://localhost:6379/0

ALLOWED_ORIGINS=https://aboladvisuals.github.io,http://localhost:5500
ALLOWED_ORIGIN_REGEX=https://.*\.github.io

GEOCODE_TTL_SECONDS=604800
ROUTE_TTL_SECONDS=21600
LIVE_TTL_SECONDS=300
STALE_AFTER_MINUTES=15
HTTP_TIMEOUT_SECONDS=15
HTTP_RETRIES=2

ANALYZE_RATE_LIMIT=20
SEARCH_RATE_LIMIT=60
LIVE_RATE_LIMIT=30
RATE_LIMIT_WINDOW_SECONDS=60

# Optional licensed feeds
# TOMTOM_API_KEY=
# NATIONAL_HIGHWAYS_SUBSCRIPTION_KEY=
# TFGM_API_KEY=
# TFGM_APP_KEY=
